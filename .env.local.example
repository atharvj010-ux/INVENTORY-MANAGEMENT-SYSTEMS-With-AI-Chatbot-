# Firebase (existing)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini AI Assistant (copy from gemini-rag-chatbot or Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest
GEMINI_MAX_OUTPUT_TOKENS=2048
WEB_SEARCH_ENABLED=true
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chroma Cloud (from gemini-rag-chatbot / CHATBOT10)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=CHATBOT
CHROMA_COLLECTION_NAME=inventory_assistant_v1
